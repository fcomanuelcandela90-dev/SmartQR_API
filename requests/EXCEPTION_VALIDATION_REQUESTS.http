### =========================================
### SMARTQR - EXCEPTION VALIDATION REQUESTS
### =========================================

@customerToken =
@otherCustomerToken =
@employeeToken =
@adminToken =


### =========================================
### 0. LOGIN PARA COPIAR TOKENS
### =========================================

### 0.1 Login CUSTOMER principal
POST http://localhost:8080/api/login
Content-Type: application/json

{
  "username": "fran.customer@smartqr.com",
  "password": "Customer123!"
}


### 0.2 Login CUSTOMER secundario
POST http://localhost:8080/api/login
Content-Type: application/json

{
  "username": "lucia.customer@smartqr.com",
  "password": "Customer123!"
}


### 0.3 Login EMPLOYEE
POST http://localhost:8080/api/login
Content-Type: application/json

{
  "username": "employee@smartqr.com",
  "password": "Employee123!"
}


### 0.4 Login ADMIN
POST http://localhost:8080/api/login
Content-Type: application/json

{
  "username": "admin@smartqr.com",
  "password": "Admin123!"
}


### =========================================
### 1. AUTENTICACION Y ROLES
### =========================================

### 1.1 [401] Consultar endpoint protegido sin token
GET http://localhost:8080/dashboard/metrics
Accept: application/json


### 1.2 [401] Consultar endpoint protegido con token falso
GET http://localhost:8080/dashboard/metrics
Accept: application/json
Authorization: Bearer TOKEN_FALSO


### 1.3 [403] CUSTOMER no puede ver dashboard
GET http://localhost:8080/dashboard/metrics
Accept: application/json
Authorization: Bearer {{customerToken}}


### 1.4 [403] CUSTOMER no puede crear QR de mesa
POST http://localhost:8080/qr/table/9
Accept: image/png
Authorization: Bearer {{customerToken}}


### 1.5 [403] EMPLOYEE no puede crear productos
POST http://localhost:8080/products
Content-Type: application/json
Authorization: Bearer {{employeeToken}}

{
  "name": "Producto no permitido",
  "description": "Debe fallar porque employee no puede crear productos",
  "price": 4.50,
  "category": "DRINK",
  "available": true
}


### =========================================
### 2. VALIDACIONES DE ENTRADA
### =========================================

### 2.1 [400] Registro con email invalido
POST http://localhost:8080/auth/register
Content-Type: application/json

{
  "name": "Email Invalido",
  "email": "email-mal",
  "password": "Customer123!"
}


### 2.2 [409] Registro duplicado
POST http://localhost:8080/auth/register
Content-Type: application/json

{
  "name": "Francisco Manuel Candela",
  "email": "fran.customer@smartqr.com",
  "password": "Customer123!"
}


### 2.3 [400] Crear pedido con cantidad cero
POST http://localhost:8080/orders
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "tableNumber": 9,
  "items": [
    {
      "productId": 1,
      "quantity": 0,
      "notes": "Debe fallar por cantidad cero"
    }
  ]
}


### 2.4 [404] Crear pedido con producto inexistente
POST http://localhost:8080/orders
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "tableNumber": 9,
  "items": [
    {
      "productId": 999999,
      "quantity": 1,
      "notes": "Producto inexistente"
    }
  ]
}


### 2.5 [400] Recomendacion de combo con presupuesto negativo
POST http://localhost:8080/ai/combo-recommendation
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "preferences": "Quiero algo para compartir",
  "maxBudget": -10.00,
  "numberOfPeople": 3
}


### 2.6 [400] OpenAI admin chat sin conversationId
POST http://localhost:8080/agent/openai/ask
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "conversationId": "",
  "question": "Resume el estado actual del restaurante."
}


### 2.7 [400] OpenAI admin chat sin pregunta
POST http://localhost:8080/agent/openai/ask
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "conversationId": "validation-admin",
  "question": ""
}


### =========================================
### 3. REGLAS DE NEGOCIO DE PEDIDOS Y PAGOS
### =========================================

### 3.1 [OK] CUSTOMER crea un pedido valido para pruebas negativas
POST http://localhost:8080/orders
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "tableNumber": 9,
  "items": [
    {
      "productId": 1,
      "quantity": 1,
      "notes": "Pedido base para validaciones"
    },
    {
      "productId": 2,
      "quantity": 1,
      "notes": "Sin cambios"
    }
  ]
}


### 3.2 [400] Cash insuficiente para Pedido ID 1
POST http://localhost:8080/payments/cash/request
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "orderId": 1,
  "cashReceived": 1.00
}


### 3.3 [404] Consultar pedido inexistente
GET http://localhost:8080/orders/999999
Accept: application/json
Authorization: Bearer {{adminToken}}


### 3.4 [400/404] Ticket de pedido no pagado o inexistente
GET http://localhost:8080/payments/ticket/999999
Accept: */*
Authorization: Bearer {{adminToken}}


### 3.5 [OK] Pagar Pedido ID 1 con tarjeta
POST http://localhost:8080/payments/card
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "orderId": 1,
  "cardHolderName": "Francisco Manuel Candela",
  "last4Digits": "4242",
  "transactionId": "txn_validation_001"
}


### 3.6 [409] Intentar pagar otra vez el Pedido ID 1
POST http://localhost:8080/payments/card
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "orderId": 1,
  "cardHolderName": "Francisco Manuel Candela",
  "last4Digits": "4242",
  "transactionId": "txn_validation_002"
}


### =========================================
### 4. OWNERSHIP DEL CUSTOMER
### =========================================

### 4.1 [403] CUSTOMER secundario no puede consultar Pedido ID 1
GET http://localhost:8080/orders/1
Accept: application/json
Authorization: Bearer {{otherCustomerToken}}


### 4.2 [403] CUSTOMER secundario no puede pagar Pedido ID 1
POST http://localhost:8080/payments/card
Content-Type: application/json
Authorization: Bearer {{otherCustomerToken}}

{
  "orderId": 1,
  "cardHolderName": "Lucia Customer",
  "last4Digits": "1111",
  "transactionId": "txn_forbidden_owner_001"
}


### 4.3 [403] CUSTOMER secundario no puede descargar ticket del Pedido ID 1
GET http://localhost:8080/payments/ticket/1
Accept: text/plain
Authorization: Bearer {{otherCustomerToken}}


### 4.4 [403] CUSTOMER secundario no puede dejar feedback sobre Pedido ID 1
POST http://localhost:8080/feedback
Content-Type: application/json
Authorization: Bearer {{otherCustomerToken}}

{
  "orderId": 1,
  "rating": 4,
  "comment": "Intento de feedback sobre un pedido ajeno."
}


### =========================================
### 5. ADMIN CHAT Y MCP
### =========================================

### 5.1 [OK] OpenAI admin chat con memoria JDBC
POST http://localhost:8080/agent/openai/ask
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "conversationId": "validation-admin",
  "question": "Resume brevemente el estado actual del restaurante."
}


### 5.2 [OK] OpenAI admin chat con la misma conversacion
POST http://localhost:8080/agent/openai/ask
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "conversationId": "validation-admin",
  "question": "Con lo anterior, que reforzarias para un dia con mas pedidos?"
}


### 5.3 [403] CUSTOMER no puede usar chat administrativo OpenAI
POST http://localhost:8080/agent/openai/ask
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "conversationId": "forbidden-customer",
  "question": "Intenta consultar informacion administrativa."
}


### 5.4 [403] CUSTOMER no puede usar MCP
POST http://localhost:8080/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Authorization: Bearer {{customerToken}}

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/list",
  "params": {}
}


### 5.5 [OK] ADMIN lista tools MCP
POST http://localhost:8080/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Authorization: Bearer {{adminToken}}

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/list",
  "params": {}
}