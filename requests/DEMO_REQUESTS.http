### ============================================================
### SMARTQR API - DEMO TOTAL FINAL
### ============================================================

@baseUrl = http://localhost:8080

@customerToken =

@employeeToken =

@adminToken =

@order1Id = 1
@order2Id = 2
@order3Id = 3
@order4Id = 4
@order5Id = 5


### ============================================================
### 0. LOGIN Y DATOS BASE
### ============================================================

### 0.1 Registrar customer de demo

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Demo Total Customer",
  "email": "demo.total.customer@smartqr.com",
  "password": "Customer123!"
}


### 0.2 Login CUSTOMER

POST {{baseUrl}}/api/login
Content-Type: application/json

{
  "username": "demo.total.customer@smartqr.com",
  "password": "Customer123!"
}


### 0.3 Login EMPLOYEE

POST {{baseUrl}}/api/login
Content-Type: application/json

{
  "username": "employee@smartqr.com",
  "password": "Employee123!"
}


### 0.4 Login ADMIN

POST {{baseUrl}}/api/login
Content-Type: application/json

{
  "username": "admin@smartqr.com",
  "password": "Admin123!"
}


### 0.5 Ver menú público desde QR de mesa 5
GET {{baseUrl}}/products/menu?table=5
Accept: application/json


### ============================================================
### PEDIDO 1 - VARIADO / CASH / DELIVERED
### ============================================================

### 1.1 CUSTOMER crea Pedido 1
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "tableNumber": 5,
  "items": [
    {
      "productId": 11,
      "quantity": 2,
      "notes": "Bravas para compartir"
    },
    {
      "productId": 13,
      "quantity": 1,
      "notes": "Nachos con bastante queso"
    },
    {
      "productId": 16,
      "quantity": 3,
      "notes": "Montaditos variados"
    },
    {
      "productId": 1,
      "quantity": 2,
      "notes": "Jarras muy frias"
    }
  ]
}


### 1.2 CUSTOMER consulta Pedido 1
GET {{baseUrl}}/orders/{{order1Id}}
Accept: application/json
Authorization: Bearer {{customerToken}}


### 1.3 CUSTOMER solicita pago en efectivo para Pedido 1
POST {{baseUrl}}/payments/cash/request
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "orderId": {{order1Id}},
  "cashReceived": 25.00
}


### 1.4 EMPLOYEE confirma efectivo Pedido 1
PUT {{baseUrl}}/payments/cash/{{order1Id}}/confirm
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 1.5 EMPLOYEE pasa Pedido 1 a IN_KITCHEN
PATCH {{baseUrl}}/orders/{{order1Id}}/status?status=IN_KITCHEN
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 1.6 EMPLOYEE pasa Pedido 1 a READY
PATCH {{baseUrl}}/orders/{{order1Id}}/status?status=READY
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 1.7 EMPLOYEE pasa Pedido 1 a DELIVERED
PATCH {{baseUrl}}/orders/{{order1Id}}/status?status=DELIVERED
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 1.8 CUSTOMER descarga ticket Pedido 1
GET {{baseUrl}}/payments/ticket/{{order1Id}}
Accept: text/plain
Authorization: Bearer {{customerToken}}


### 1.9 CUSTOMER deja feedback Pedido 1
POST {{baseUrl}}/feedback
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "orderId": {{order1Id}},
  "rating": 5,
  "comment": "Todo muy bien. Las bravas estaban buenas, las bebidas llegaron frias y el servicio fue bastante rapido."
}


### 1.10 CUSTOMER pide recomendación IA para próxima ronda
POST {{baseUrl}}/ai/combo-recommendation
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "preferences": "Queremos algo variado para compartir, con entrantes, montaditos y bebidas frias. Si entra algo dulce o cafe, mejor.",
  "maxBudget": 45.00,
  "numberOfPeople": 5
}


### ============================================================
### PEDIDO 2 - DIFERENTE / CARD / DELIVERED
### ============================================================

### 2.1 CUSTOMER crea Pedido 2
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "tableNumber": 5,
  "items": [
    {
      "productId": 14,
      "quantity": 1,
      "notes": "Ensalada para compartir"
    },
    {
      "productId": 21,
      "quantity": 2,
      "notes": "Montaditos de pollo"
    },
    {
      "productId": 4,
      "quantity": 2,
      "notes": "Refrescos muy frios"
    },
    {
      "productId": 10,
      "quantity": 2,
      "notes": "Cafe para despues"
    }
  ]
}


### 2.2 CUSTOMER paga Pedido 2 con tarjeta
POST {{baseUrl}}/payments/card
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "orderId": {{order2Id}},
  "cardHolderName": "Demo Total Customer",
  "last4Digits": "4242",
  "transactionId": "txn_demo_total_order_2"
}


### 2.3 EMPLOYEE consulta cola de cocina
GET {{baseUrl}}/orders/kitchen/queue
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 2.4 EMPLOYEE pasa Pedido 2 a READY
PATCH {{baseUrl}}/orders/{{order2Id}}/status?status=READY
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 2.5 EMPLOYEE pasa Pedido 2 a DELIVERED
PATCH {{baseUrl}}/orders/{{order2Id}}/status?status=DELIVERED
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 2.6 CUSTOMER descarga ticket Pedido 2
GET {{baseUrl}}/payments/ticket/{{order2Id}}
Accept: text/plain
Authorization: Bearer {{customerToken}}


### 2.7 CUSTOMER deja feedback Pedido 2
POST {{baseUrl}}/feedback
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "orderId": {{order2Id}},
  "rating": 4,
  "comment": "La comida estuvo bien y los montaditos salieron rapido. El unico detalle es que uno de los refrescos podria haber estado mas frio."
}


### 2.8 CUSTOMER pide recomendación IA ligera
POST {{baseUrl}}/ai/combo-recommendation
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "preferences": "Queremos una opcion ligera con ensalada, alguna bebida sin alcohol y un par de montaditos.",
  "maxBudget": 28.00,
  "numberOfPeople": 2
}


### ============================================================
### PEDIDO 3 - CASH / CAMBIO DE ARTICULOS POR EMPLOYEE / DELIVERED
### ============================================================

### 3.1 CUSTOMER crea Pedido 3
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "tableNumber": 5,
  "items": [
    {
      "productId": 17,
      "quantity": 2,
      "notes": "Pedido inicial antes del cambio"
    },
    {
      "productId": 6,
      "quantity": 2,
      "notes": "Agua para la mesa"
    }
  ]
}


### 3.2 EMPLOYEE modifica articulos del Pedido 3 mientras está PENDING
PUT {{baseUrl}}/orders/{{order3Id}}/items
Content-Type: application/json
Authorization: Bearer {{employeeToken}}

[
  {
    "productId": 20,
    "quantity": 2,
    "notes": "Cambio a montadito campero"
  },
  {
    "productId": 11,
    "quantity": 1,
    "notes": "Añadimos una racion de bravas"
  },
  {
    "productId": 3,
    "quantity": 2,
    "notes": "Dos tintos de verano"
  }
]


### 3.3 CUSTOMER consulta Pedido 3 tras modificación
GET {{baseUrl}}/orders/{{order3Id}}
Accept: application/json
Authorization: Bearer {{customerToken}}


### 3.4 CUSTOMER solicita pago en efectivo Pedido 3
POST {{baseUrl}}/payments/cash/request
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "orderId": {{order3Id}},
  "cashReceived": 20.00
}


### 3.5 EMPLOYEE confirma efectivo Pedido 3
PUT {{baseUrl}}/payments/cash/{{order3Id}}/confirm
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 3.6 EMPLOYEE pasa Pedido 3 a IN_KITCHEN
PATCH {{baseUrl}}/orders/{{order3Id}}/status?status=IN_KITCHEN
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 3.7 EMPLOYEE pasa Pedido 3 a READY
PATCH {{baseUrl}}/orders/{{order3Id}}/status?status=READY
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 3.8 EMPLOYEE pasa Pedido 3 a DELIVERED
PATCH {{baseUrl}}/orders/{{order3Id}}/status?status=DELIVERED
Accept: application/json
Authorization: Bearer {{employeeToken}}


### 3.9 CUSTOMER descarga ticket Pedido 3
GET {{baseUrl}}/payments/ticket/{{order3Id}}
Accept: text/plain
Authorization: Bearer {{customerToken}}


### 3.10 CUSTOMER deja feedback Pedido 3
POST {{baseUrl}}/feedback
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "orderId": {{order3Id}},
  "rating": 5,
  "comment": "El cambio de articulos fue un acierto. El empleado nos lo resolvio rapido y el pedido llego perfecto."
}


### 3.11 CUSTOMER pide recomendación IA para cena barata
POST {{baseUrl}}/ai/combo-recommendation
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "preferences": "Busco algo economico con dos bebidas, una racion para compartir y montaditos variados.",
  "maxBudget": 25.00,
  "numberOfPeople": 2
}


